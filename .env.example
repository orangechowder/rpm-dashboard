NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_…). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Never prefix with NEXT_PUBLIC_. Needed by /api routes (sign-in migration, user admin).
SUPABASE_SECRET_KEY=
# Local only (migrations via `npm run db:sql`). Not needed on Vercel.
SUPABASE_DB_URL=

# --- Wave → Money sync (server only; never NEXT_PUBLIC_) ---
WAVE_CLIENT_ID=            # from your Wave developer application
WAVE_CLIENT_SECRET=        # from your Wave developer application
MONEY_TOKEN_KEY=           # 32 random bytes, base64 (encrypts the Wave tokens). Same value locally and in Vercel.
WAVE_REDIRECT_URI=         # optional; default https://<your site>/api/money/wave/callback
CRON_SECRET=               # Vercel sends it to the nightly job; any long random string
RESEND_API_KEY=            # Resend API key (send.rpm-diesel.ca) for "the sync stopped" emails
MONEY_ALERT_EMAIL=         # who gets those emails (comma-separated)
MONEY_ALERT_FROM=          # optional; default "RPM Money <money@send.rpm-diesel.ca>"
